# Funchal Pescados - Universal .htaccess (Local & Production compatible)
RewriteEngine On

# Auto-detect RewriteBase (Optional but helpful for some environments)
# RewriteBase /

# 1. Force HTTPS and non-WWW (Canonical) - Only in Production
#RewriteCond %{HTTP_HOST} !^localhost [NC]
#RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
#RewriteCond %{HTTPS} off [OR]
#RewriteCond %{HTTP_HOST} ^www\. [NC]
#RewriteRule ^(.*)$ https://funchalpescados.com.br/$1 [L,R=301]

# 2. Sitemap Rewrite
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 3. Dynamic Routes: Jobs (Vagas)
RewriteRule ^vaga/([^/]+)/?$ vaga.php?id=$1 [L,QSA]
RewriteRule ^en/vaga/([^/]+)/?$ vaga.php?id=$1&lang=en [L,QSA]

# 4. Dynamic Routes: Blog Posts
RewriteRule ^post/([^/]+)/?$ post.php?id=$1 [L,QSA]
RewriteRule ^en/post/([^/]+)/?$ post.php?id=$1&lang=en [L,QSA]

# 5. Language Prefixes (Friendly URLs)
# Handle /en/PAGE -> PAGE.php?lang=en
RewriteRule ^en/([^/.]+)/?$ $1.php?lang=en [L,QSA]
# Handle /en/ -> index.php?lang=en
RewriteRule ^en/?$ index.php?lang=en [L,QSA]

# 6. Friendly URLs without .php extension
# Redirect PAGE.php to PAGE (to clean old URLs)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Resolve clean URL to .php file internally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/.]+)/?$ $1.php [L]

# 7. Security: Block sensitive files
<FilesMatch "^(config|products_data|load_env|\.env|composer\.json)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 8. Performance: GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# 9. Performance: Browser Caching (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    # Assets
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 10. Performance: Disable ETags
FileETag None
